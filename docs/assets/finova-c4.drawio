<mxfile host="app.diagrams.net" pages="2"><diagram name="C4 Level 1 - System Context" id="c1-context"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Finova P2P Virtual Wallet - System Context (C4 Level 1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Wallet User&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Holds a wallet, checks the balance and sends money to other users.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="260" height="140" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Operations / Compliance Analyst&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Reviews the immutable audit trail of transfer attempts.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="260" height="140" as="geometry"/></mxCell><mxCell id="finova" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Finova P2P Virtual Wallet&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Authenticates users, serves balances, executes P2P transfers exactly once with saga compensation, and audits every attempt.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="400" height="170" as="geometry"/></mxCell><mxCell id="prov" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Email / SMS / Push Provider&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[External Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Delivers push, email and SMS notifications.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="680" width="340" height="130" as="geometry"/></mxCell><mxCell id="r1" value="Logs in, checks balance, sends money&lt;br&gt;&lt;i&gt;[HTTPS/JSON]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="finova"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="Queries audit records&lt;br&gt;&lt;i&gt;[HTTPS/JSON]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="finova"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3" value="Sends transfer notifications&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="finova" target="prov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="C4 Level 2 - Containers" id="c2-containers"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1540" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Finova P2P Virtual Wallet - Container Diagram (C4 Level 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Wallet User&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Checks balance and sends money.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="250" height="110" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Operations / Compliance Analyst&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Reviews the audit trail.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="250" height="110" as="geometry"/></mxCell><mxCell id="bnd" value="&lt;b&gt;Finova P2P Virtual Wallet&lt;/b&gt; [Software System]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1740" height="1310" as="geometry"/></mxCell><mxCell id="mobile" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Mobile / Web App&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Mobile app / SPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Login, step-up (PIN/OTP), balance, transfers. Generates one Idempotency-Key per transfer intent.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="250" height="130" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Admin Dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: SPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Internal UI to query audit records.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="230" width="250" height="130" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Spring Cloud Gateway]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Single entry point. Validates JWT (JWKS), enforces the financial session, mandatory Idempotency-Key pre-check, rate limiting, lockout, routing.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#2E6FB3;strokeColor=#1F4F80;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="400" height="140" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Redis 7]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Idempotency records (SET NX + TTL 24h), sessions and revoked JTIs, rate-limit counters, balance read model (versioned).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#C0392B;strokeColor=#922B21;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="370" height="140" as="geometry"/></mxCell><mxCell id="identity" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Identity Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Java 21, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Users, devices, login, JWT (15 min) + rotating refresh, financial session (step-up).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="250" height="140" as="geometry"/></mxCell><mxCell id="wallet" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Wallet Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Java 21, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Wallet aggregate, conditional atomic debit, credit, reversal, ledger entries. Idempotent per transferId.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="250" height="140" as="geometry"/></mxCell><mxCell id="transfer" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Transfer Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Java 21, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Transfer state machine, saga orchestrator (debit, credit, complete or compensate), transactional outbox.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="660" width="250" height="140" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Audit Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Java 21, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Stores every transfer attempt and outcome. Append-only with SHA-256 hash chaining.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="660" width="250" height="140" as="geometry"/></mxCell><mxCell id="notif" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Java 21, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Sends outcome notifications from events. Never in the critical path.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="660" width="250" height="140" as="geometry"/></mxCell><mxCell id="identitydb" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Identity DB&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;users, devices, sessions&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="160" height="120" as="geometry"/></mxCell><mxCell id="walletdb" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Wallet DB&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;wallets, ledger_entries, outbox&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="850" width="160" height="120" as="geometry"/></mxCell><mxCell id="transferdb" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Transfer DB&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;transfers, saga state, outbox&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="850" width="160" height="120" as="geometry"/></mxCell><mxCell id="auditdb" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Audit DB&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;audit_records (INSERT only)&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="850" width="160" height="120" as="geometry"/></mxCell><mxCell id="notifdb" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Notification DB&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;notification_log&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="850" width="160" height="120" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Message Broker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: RabbitMQ]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Exchanges: wallet.commands (DebitWallet, CreditWallet, ReverseDebit), wallet.events, transfer.events, audit.events. Durable quorum queues, publisher confirms, at-least-once delivery, DLQ per queue.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#E07B39;strokeColor=#B35F27;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1690" height="110" as="geometry"/></mxCell><mxCell id="prov" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Email / SMS / Push Provider&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[External Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Delivers push, email and SMS notifications.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1820" y="665" width="240" height="130" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Dark blue: person&lt;br&gt;Blue: container (app / service)&lt;br&gt;Cylinder: database (one per service)&lt;br&gt;Red: Redis&lt;br&gt;Orange: RabbitMQ&lt;br&gt;Grey: external system&lt;br&gt;Green: observability&lt;br&gt;&lt;br&gt;Every service is hexagonal and owns its database (no shared DB). Every message carries transferId and correlationId." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#222222;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1820" y="230" width="240" height="240" as="geometry"/></mxCell><mxCell id="e1" value="Uses&lt;br&gt;&lt;i&gt;[Touch / browser]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="mobile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Uses&lt;br&gt;&lt;i&gt;[Browser]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="admin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="API calls: Bearer JWT,&lt;br&gt;Idempotency-Key, X-Financial-Session&lt;br&gt;&lt;i&gt;[HTTPS/JSON]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1625;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mobile" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Audit queries&lt;br&gt;&lt;i&gt;[HTTPS/JSON]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Idempotency,&lt;br&gt;revocation,&lt;br&gt;rate limits&lt;br&gt;&lt;i&gt;[RESP]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Login, refresh, step-up&lt;br&gt;&lt;i&gt;[HTTPS/REST]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="identity"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="615"/><mxPoint x="227" y="615"/></Array></mxGeometry></mxCell><mxCell id="e7" value="GET /balance&lt;br&gt;&lt;i&gt;[HTTPS/REST]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.88;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="wallet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="POST /transfers (202)&lt;br&gt;GET /transfers/{id}&lt;br&gt;&lt;i&gt;[HTTPS/REST]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.16;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="transfer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Audit queries (admin)&lt;br&gt;&lt;i&gt;[HTTPS/REST]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.95