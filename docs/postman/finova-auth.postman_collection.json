                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Login lockout (locks beto for 15 minutes)",
      "item": [
        {
          "name": "Login beto - wrong password (send 6 times)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "F1.5: after 5 failures in 15 minutes the Gateway answers 423 ACCOUNT_LOCKED without reaching Identity.\n\nRun it about a minute after the other folders: POST /auth/login is also limited to 10 requests per minute per client IP, and a 429 RATE_LIMIT_EXCEEDED hides the lockout.\n\nTo unlock beto sooner: docker compose exec redis redis-cli DEL lock:login:beto@example.com fail:login:beto@example.com",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"beto@example.com\",\n  \"password\": \"wrong\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 INVALID_CREDENTIALS, then 423 ACCOUNT_LOCKED from the 6th try\", () => pm.expect(pm.response.code).to.be.oneOf([401, 423]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Needs wallet-service / transfer-service",
      "item": [
        {
          "name": "Login (ana)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "pm.test(\"token pair\", () => {",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.expiresIn).to.eql(900);",
                  "    pm.expect(body.refreshExpiresIn).to.eql(604800);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/wallets/me/balance",
            "description": "Needs wallet-service running and a wallet for ana's userId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Step-up with PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/financial-session",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"PIN\",\n  \"credential\": \"{{pin}}\",\n  \"scope\": \"transfer:create\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"financialSessionToken\", pm.response.json().financialSessionToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Financial-Session",
                "value": "{{financialSessionToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/transfers",
            "description": "Needs transfer-service. Resend with the same Idempotency-Key to see the replay (Idempotent-Replayed: true).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientUserId\": \"{{recipientUserId}}\",\n  \"amount\": \"1000.00\",\n  \"currency\": \"COP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
