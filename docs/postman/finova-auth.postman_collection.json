{
  "info": {
    "name": "Finova - Auth through the Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Feature 1 (spec.md \u00a73.1, \u00a73.3-3.6) through the API Gateway at {{baseUrl}}.\n\nRun the folders in order (or the whole collection with the Runner): each request stores the tokens the next one needs.\n\nNeeds only api-gateway + identity-service (+ identity-db, redis). Folder 6 also needs wallet-service / transfer-service.\n\nDemo users and their PIN / TOTP secrets: README.md, \"Demo users\"."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "ana@example.com"
    },
    {
      "key": "password",
      "value": "Finova2026!"
    },
    {
      "key": "pin",
      "value": "4821"
    },
    {
      "key": "otpSecret",
      "value": "JOJYF2MFLYMVTZVHPQXBEZXZPG3BSRZ2"
    },
    {
      "key": "deviceId",
      "value": "postman-device-1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "previousRefreshToken",
      "value": ""
    },
    {
      "key": "financialSessionToken",
      "value": ""
    },
    {
      "key": "otpCode",
      "value": ""
    },
    {
      "key": "recipientUserId",
      "value": "2b9d4e6f-1a3c-4e5b-9d7f-0a1b2c3d4e5f"
    }
  ],
  "item": [
    {
      "name": "1. Login and refresh rotation",
      "item": [
        {
          "name": "Login (ana)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "F1.1: 15-minute access token + 7-day refresh token bound to deviceId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "pm.test(\"token pair\", () => {",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.expiresIn).to.eql(900);",
                  "    pm.expect(body.refreshExpiresIn).to.eql(604800);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Counts toward the lockout (5 in 15 min). Do not send it 5 times for ana or she stays locked for 15 minutes; folder 5 demos the lockout with beto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code INVALID_CREDENTIALS\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_CREDENTIALS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - rotates the token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "F1.2: new pair in the same session; the presented token becomes ROTATED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"previousRefreshToken\", pm.collectionVariables.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "pm.test(\"token pair\", () => {",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.expiresIn).to.eql(900);",
                  "    pm.expect(body.refreshExpiresIn).to.eql(604800);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - token from another device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Refresh tokens are bound to the device that logged in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"deviceId\": \"another-device\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code REFRESH_TOKEN_INVALID\", () => pm.expect(pm.response.json().code).to.eql(\"REFRESH_TOKEN_INVALID\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - reuse of the rotated token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "F1.3: a rotated token presented again revokes the whole session (revoked:sid in Redis).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{previousRefreshToken}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code REFRESH_TOKEN_REUSED\", () => pm.expect(pm.response.json().code).to.eql(\"REFRESH_TOKEN_REUSED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Access token of the revoked session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/wallets/me/balance",
            "description": "F1.4: the Gateway rejects it before reaching Wallet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code TOKEN_REVOKED\", () => pm.expect(pm.response.json().code).to.eql(\"TOKEN_REVOKED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Financial session (step-up)",
      "item": [
        {
          "name": "Login (ana) again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "pm.test(\"token pair\", () => {",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.expiresIn).to.eql(900);",
                  "    pm.expect(body.refreshExpiresIn).to.eql(604800);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Step-up with PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/financial-session",
            "description": "F1.6.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"PIN\",\n  \"credential\": \"{{pin}}\",\n  \"scope\": \"transfer:create\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"financialSessionToken\", body.financialSessionToken);",
                  "pm.test(\"5-minute transfer:create session\", () => {",
                  "    pm.expect(body.scope).to.eql(\"transfer:create\");",
                  "    pm.expect(body.expiresIn).to.eql(300);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Step-up with OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/financial-session",
            "description": "The pre-request script computes the current TOTP code from {{otpSecret}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"OTP\",\n  \"credential\": \"{{otpCode}}\",\n  \"scope\": \"transfer:create\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// RFC 6238 TOTP from the demo secret in {{otpSecret}} (what an authenticator app would show now).",
                  "const alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567\";",
                  "let bits = \"\";",
                  "for (const c of pm.collectionVariables.get(\"otpSecret\").replace(/=+$/, \"\")) {",
                  "    bits += alphabet.indexOf(c).toString(2).padStart(5, \"0\");",
                  "}",
                  "let keyHex = \"\";",
                  "for (let i = 0; i + 8 <= bits.length; i += 8) {",
                  "    keyHex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, \"0\");",
                  "}",
                  "const counterHex = Math.floor(Date.now() / 1000 / 30).toString(16).padStart(16, \"0\");",
                  "const hmac = CryptoJS.HmacSHA1(CryptoJS.enc.Hex.parse(counterHex), CryptoJS.enc.Hex.parse(keyHex)).toString();",
                  "const offset = parseInt(hmac.slice(-1), 16);",
                  "const code = ((parseInt(hmac.substr(offset * 2, 8), 16) & 0x7fffffff) % 1000000).toString().padStart(6, \"0\");",
                  "pm.collectionVariables.set(\"otpCode\", code);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Step-up - wrong PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/financial-session",
            "description": "Counts toward the step-up lockout (5 in 15 min).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"PIN\",\n  \"credential\": \"0000\",\n  \"scope\": \"transfer:create\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code STEP_UP_FAILED\", () => pm.expect(pm.response.json().code).to.eql(\"STEP_UP_FAILED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Step-up - another scope",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/financial-session",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"PIN\",\n  \"credential\": \"{{pin}}\",\n  \"scope\": \"profile:update\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"code VALIDATION_ERROR\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
