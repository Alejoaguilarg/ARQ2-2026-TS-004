# Copy to .env and adjust. .env is git-ignored.
GATEWAY_PORT=8080

RABBITMQ_USER=finova
RABBITMQ_PASSWORD=finova
RABBITMQ_UI_PORT=15672
# Optional: run the services against a cloud broker (CloudAMQP) instead of the local one. Set the values
# above to the cloud user and password, uncomment these, and import infra/rabbitmq/definitions.json into
# that vhost once (the services never declare queues). Never commit the real values; .env is git-ignored.
#RABBITMQ_HOST=xxx.rmq.cloudamqp.com
#RABBITMQ_PORT=5671
#RABBITMQ_VHOST=your-vhost
#RABBITMQ_SSL_ENABLED=true

IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity
WALLET_DB_USER=wallet
WALLET_DB_PASSWORD=wallet
TRANSFER_DB_USER=transfer
TRANSFER_DB_PASSWORD=transfer
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=audit
# audit-service itself logs in with this role (INSERT and SELECT only); the one above is the owner, for Flyway.
AUDIT_DB_APP_USER=audit_app
AUDIT_DB_APP_PASSWORD=audit_app
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification
# Optional: notification-service sends EMAIL notifications for real through SMTP (Gmail needs 2-Step
# Verification and an app password, not the account password). PUSH and SMS keep going to the mock.
#NOTIFICATION_EMAIL_ENABLED=true
#NOTIFICATION_SMTP_USER=your-account@gmail.com
#NOTIFICATION_SMTP_PASSWORD=your-16-letter-app-password
# Demo inbox: every email notification goes to this address, whoever it was for (the body says who).
# The demo users have example.com addresses, which receive nothing.
#NOTIFICATION_DEMO_INBOX=team-inbox@gmail.com

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
