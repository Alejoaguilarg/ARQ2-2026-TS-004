// Ships the stdout/stderr of every Finova container to Loki.
discovery.docker "finova" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=finova"]
  }
}

discovery.relabel "finova" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "finova" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.finova.targets
  relabel_rules = discovery.relabel.finova.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Receives OTLP traces from the services and forwards them to Tempo and Jaeger.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.filter.noise.input]
  }
}

// Drops only the spans that bury the real ones: @Scheduled runs ("task <bean>.<method>", e.g. Transfer's outbox
// relay every 100 ms) and the healthcheck and Prometheus scrapes. Spans of a transfer never match: their HTTP uri is
// /transfers..., and AMQP spans have no uri. A condition that cannot be evaluated keeps the span (error_mode).
otelcol.processor.filter "noise" {
  error_mode = "ignore"

  traces {
    span = [
      `IsMatch(name, "^task ")`,
      `IsMatch(attributes["uri"], "^/actuator/(health|prometheus)(/.*)?$")`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input, otelcol.exporter.otlp.jaeger.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlp "jaeger" {
  client {
    endpoint = "jaeger:4317"

    tls {
      insecure = true
    }
  }
}
