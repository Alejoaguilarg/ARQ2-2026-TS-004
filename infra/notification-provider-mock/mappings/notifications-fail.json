{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "/(push|email|sms)",
        "bodyPatterns": [ { "contains": "+573009999999" } ]
      },
      "response": {
        "status": 503,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "UNAVAILABLE", "detail": "Simulated provider outage for the retry/DLQ demo" }
      }
    }
  ]
}
