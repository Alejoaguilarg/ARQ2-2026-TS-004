    {
      "name": "9. DLQ: peek at the messages (without removing them)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Read the DLQ', function () { pm.response.to.have.status(200); });",
              "const messages = pm.response.json();",
              "messages.forEach(m => console.log(m.properties.message_id, '->', (m.properties.headers || {})['x-notification-error']));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"count\": 10,\n  \"ackmode\": \"ack_requeue_true\",\n  \"encoding\": \"auto\",\n  \"truncate\": 50000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{rabbitUrl}}/api/queues/{{vhost}}/notification.transfer-events.q.dlq/get",
          "host": [
            "{{rabbitUrl}}"
          ],
          "path": [
            "api",
            "queues",
            "{{vhost}}",
            "notification.transfer-events.q.dlq",
            "get"
          ]
        },
        "description": "ack_requeue_true: the messages go back to the DLQ after being read. Each one carries the x-notification-error header with the cause."
      }
    }
