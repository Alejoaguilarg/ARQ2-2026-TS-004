            "{{rabbitUrl}}"
          ],
          "path": [
            "api",
            "queues",
            "{{vhost}}",
            "notification.transfer-events.q.dlq",
            "get"
          ]
        },
        "description": "ack_requeue_true: los mensajes vuelven a la DLQ después de leerlos. Cada uno trae el header x-notification-error con la causa."
      }
