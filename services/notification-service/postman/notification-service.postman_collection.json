    {
      "name": "9. DLQ: ver mensajes (sin sacarlos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Read the DLQ', function () { pm.response.to.have.status(200); });",
              "const messages = pm.response.json();",
              "messages.forEach(m => console.log(m.properties.message_id, '->', (m.properties.headers || {})['x-notification-error']));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"count\": 10,\n  \"ackmode\": \"ack_requeue_true\",\n  \"encoding\": \"auto\",\n  \"truncate\": 50000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{rabbitUrl}}/api/queues/{{vhost}}/notification.transfer-events.q.dlq/get",
