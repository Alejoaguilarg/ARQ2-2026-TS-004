{
  "info": {
    "name": "Finova - Notification Service",
    "description": "Publishes the transfer outcome events (spec §4.4) to the transfer.events exchange through the RabbitMQ HTTP API, to test the Notification Service without Transfer.\n\nVariables: the initial values point to the local RabbitMQ of docker-compose (console at localhost:15672, vhost %2F = '/', user finova). For CloudAMQP change the *Current value* of rabbitUrl, vhost, rabbitUser and rabbitPassword. Passwords go in Current value only: Postman does not export it, so it never reaches the repository.\n\nTo repeat the tests from scratch: TRUNCATE notification_log (see README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{rabbitUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{rabbitPassword}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Service health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Notification Service is UP', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{serviceUrl}}/actuator/health",
          "host": [
            "{{serviceUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "The service must be running (IntelliJ or Docker) and connected to its database and RabbitMQ."
      }
    },
    {
      "name": "1. TransferCompleted: Ana sends to Beto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('RabbitMQ accepted and routed the message to a queue', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().routed).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"properties\": {\n    \"content_type\": \"application/json\",\n    \"message_id\": \"11111111-0000-4000-8000-000000000001\",\n    \"delivery_mode\": 2\n  },\n  \"routing_key\": \"transfer.completed\",\n  \"payload\": \"{\\n  \\\"messageId\\\": \\\"11111111-0000-4000-8000-000000000001\\\",\\n  \\\"type\\\": \\\"TransferCompleted\\\",\\n  \\\"correlationId\\\": \\\"5d0f3f0e-8a4b-4a39-9a51-0f1c1b2a7e11\\\",\\n  \\\"transferId\\\": \\\"a1b2c3d4-e5f6-4890-abcd-ef1234567801\\\",\\n  \\\"producer\\\": \\\"transfer-service\\\",\\n  \\\"occurredAt\\\": \\\"2026-11-02T15:00:00Z\\\",\\n  \\\"payload\\\": {\\n    \\\"transferId\\\": \\\"a1b2c3d4-e5f6-4890-abcd-ef1234567801\\\",\\n    \\\"senderUserId\\\": \\\"7f3c2b1a-0d4e-4f5a-8b6c-9d0e1f2a3b4c\\\",\\n    \\\"recipientUserId\\\": \\\"2b9d4e6f-1a3c-4e5b-9d7f-0a1b2c3d4e5f\\\",\\n    \\\"amount\\\": \\\"150000.00\\\",\\n    \\\"currency\\\": \\\"COP\\\",\\n    \\\"completedAt\\\": \\\"2026-11-02T15:00:00Z\\\"\\n  }\\n}\",\n  \"payload_encoding\": \"string\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{rabbitUrl}}/api/exchanges/{{vhost}}/transfer.events/publish",
          "host": [
            "{{rabbitUrl}}"
          ],
          "path": [
            "api",
            "exchanges",
            "{{vhost}}",
            "transfer.events",
            "publish"
          ]
        },
        "description": "Spec §4.9: notifies Ana and Beto on their preferred channel (EMAIL). notification_log: 2 rows SENT."
      }
    },
